{% embed '@hc/page-builder.twig' %}

    {% block hero_component %}
        {% include '@hc/components/hero.twig' with {
            'section_class': 'hero-outer full solid',
            'image_data': get_image_data( post.meta('hero_section').image, 'hero_image' ),
            'hero_title': post.title|e('esc_html'),
            'hero_summary': post.meta('hero_section').summary|e('wp_kses_post'),
            'link_copy': post.meta( 'hero_section' ).button.title|e('esc_html'),
            'link_path': post.meta( 'hero_section' ).button.url|e('esc_url'),
            'link_target': post.meta( 'hero_section' ).button.target|e('esc_html')
        } %}
    {% endblock %}

    {% block breadcrumb %}
        {% include '@wp/partials/breadcrumbs.twig' with {
            'subnav': subnav
        } %}
    {% endblock breadcrumb %}

    {% block main_content %}
        <div class="main-section services-listing" id="content">

            {% if services_feed %}
                <div class="services-grid">
                    {% for service in services_feed %}
                        <div class="service-card">
                            {% if service.image_data %}
                                <div class="service-icon">
                                    <img src="{{ service.image_data.src }}" alt="{{ service.image_data.alt }}" loading="lazy" />
                                </div>
                            {% endif %}
                            <h2 class="service-title">
                                <a href="{{ service.path }}">{{ service.title }}</a>
                            </h2>
                            {% if service.label %}
                                <span class="service-category tag">{{ service.label }}</span>
                            {% endif %}
                            {% if service.summary %}
                                <div class="service-summary">
                                    {{ service.summary|raw }}
                                </div>
                            {% endif %}
                            {% if service.features %}
                                <ul class="service-features">
                                    {% for feature in service.features %}
                                        <li>{{ feature.feature|e('esc_html') }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            {% if service.cta %}
                                <a href="{{ service.cta.link }}" class="button service-cta">{{ service.cta.text }}</a>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="no-results">
                    <p>No services found.</p>
                </div>
            {% endif %}

            {# CTA Section #}
            {{ post.content }}

            {% if pagination %}
                <footer class="main-footer section pagination-outer">
                    <div class="container">
                        {% include '@wp/partials/pagination-wp.twig' %}
                    </div>
                </footer>
            {% endif %}

        </div>
    {% endblock main_content %}

{% endembed %}
