{% set meta_sitename = site.name|striptags %}
{% set meta_color = '#1a1a2e' %}
{% set cms = 'WordPress' %}

{% set webfont_preloads %}
	<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
{% endset %}

{% set navigation = global_nav %}
{% set secnav = sec_nav %}

{% set socials = [
	{ 'selector': 'linkedin', 'path': '#' },
	{ 'selector': 'github', 'path': '#' }
] %}

{% set buttons = [
	{ 'text': 'Get in Touch', 'url': '/contact/' }
] %}

{% set footer_nav = [
	{ 'text': 'Home', 'url': '/' },
	{ 'text': 'About', 'url': '/about/' },
	{ 'text': 'Projects', 'url': '/projects/' },
	{ 'text': 'Services', 'url': '/services/' },
	{ 'text': 'Blog', 'url': '/blog/' },
	{ 'text': 'Contact', 'url': '/contact/' }
] %}

{% set quicklinks = [
	{ 'text': 'Projects', 'url': '/projects/' },
	{ 'text': 'Blog', 'url': '/blog/' },
	{ 'text': 'Services', 'url': '/services/' },
	{ 'text': 'About', 'url': '/about/' }
] %}

{% set site_tools = [
	{ 'text': 'Sitemap', 'url': '#' },
	{ 'text': 'Accessibility', 'url': '#' },
	{ 'text': 'Privacy & cookies', 'url': '#' }
] %}

{% set copyright_text = '&copy; ' ~ 'now'|date('Y') ~ ' Joshua Adumchimma. All Rights Reserved.' %}
{% set charity_info = 'Built on Honeycomb 3 by Fat Beehive' %}

{# This is the htmlPage block that all other content is rendered into, don't delete unless you want a broken site #}
{% block htmlPage %}
{% endblock %}
