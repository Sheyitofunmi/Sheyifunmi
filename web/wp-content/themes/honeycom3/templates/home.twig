{% embed '@hc/home.twig' %}

	{% block home_hero %}
		{% set c = post.meta('hero') %}
		{% include '@hc/components/hero.twig' with {
			'section_class': 'hero-outer full portfolio-hero',
			'image_data': get_image_data( c.image, 'hero_image' ),
			'hero_title': c.title ? c.title|e('esc_html') : 'Joshua Adumchimma',
			'hero_summary': c.summary ? c.summary|striptags|nl2br : 'Lead WordPress Support Developer — Fat Beehive',
			'link_copy': c.link ? c.link.title|e('esc_html') : 'View My Work',
			'link_path': c.link ? c.link.url|e('esc_url') : '/projects/',
		} %}
	{% endblock home_hero %}

	{% block home_wysiwyg %}
		{% if post.meta('optional_copy') %}
			{% include '@hc/components/wysiwyg.twig' with {
				'section_class': 'wysiwyg-outer center',
				'wysiwyg_content': post.meta('optional_copy')|e('wp_kses_post'),
			} %}
		{% endif %}
	{% endblock %}

	{% block home_signposts %}
		{# Featured Projects Section #}
		{% if featured_projects %}
			{% include '@hc/components/cards.twig' with {
				'section_class': 'cards-outer featured-projects',
				'title': 'Featured Projects',
				'summary': 'Recent work demonstrating HC3 expertise and WordPress development.',
				'header_link': 'View All Projects',
				'header_link_path': '/projects/',
				'cards': featured_projects
			} %}
		{% endif %}
	{% endblock home_signposts %}

	{% block home_impact %}
		{# Services Overview Section #}
		{% if services_overview %}
			<section class="services-overview-section section">
				<div class="container">
					<div class="section-header">
						<h2>Services</h2>
						<p>Professional WordPress development, support, and consulting services.</p>
						<a href="/services/" class="button">View All Services</a>
					</div>
					<div class="services-grid">
						{% for service in services_overview %}
							<div class="service-card-mini">
								{% if service.image_data %}
									<div class="service-icon">
										<img src="{{ service.image_data.src }}" alt="{{ service.image_data.alt }}" loading="lazy" />
									</div>
								{% endif %}
								<h3><a href="{{ service.path }}">{{ service.title }}</a></h3>
								{% if service.summary %}
									<p>{{ service.summary|striptags|slice(0, 120) ~ '...' }}</p>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				</div>
			</section>
		{% endif %}
	{% endblock home_impact %}

	{% block home_footer_ctas %}
		{# Testimonials Section #}
		{% if testimonial_snippets %}
			<section class="testimonials-section section">
				<div class="container">
					<h2>What Clients Say</h2>
					<div class="testimonials-grid">
						{% for testimonial in testimonial_snippets %}
							<blockquote class="testimonial-card">
								<p class="testimonial-quote">"{{ testimonial.quote }}"</p>
								<footer class="testimonial-footer">
									{% if testimonial.client_photo %}
										<img src="{{ testimonial.client_photo.src }}" alt="{{ testimonial.client_name }}" class="testimonial-photo" loading="lazy" />
									{% endif %}
									<div>
										<cite>{{ testimonial.client_name }}</cite>
										{% if testimonial.client_role %}
											<span class="testimonial-role">{{ testimonial.client_role }}</span>
										{% endif %}
										{% if testimonial.rating %}
											<div class="testimonial-rating" aria-label="{{ testimonial.rating }} out of 5 stars">
												{% for i in 1..5 %}
													<span class="star {% if i <= testimonial.rating %}star--filled{% endif %}">★</span>
												{% endfor %}
											</div>
										{% endif %}
									</div>
								</footer>
							</blockquote>
						{% endfor %}
					</div>
				</div>
			</section>
		{% endif %}
	{% endblock home_footer_ctas %}

	{% block home_stats %}
		{% set c = post.meta('statistics') %}
		{% if c %}
			{% include '@hc/components/statistics.twig' with {
				'section_id': 'stats',
				'section_class': 'statistic-outer',
				'title': c.title|e('esc_html'),
				'summary': c.summary|striptags|nl2br,
				'link': c.button.title|e('esc_html'),
				'link_path': c.button.url|e('esc_url'),
				'statistics': home_stats
			} %}
		{% endif %}
	{% endblock home_stats %}

	{% block tabs %}
		{# Latest Blog Posts Section #}
		{% if latest_blog_posts %}
			<section class="blog-preview-section section">
				<div class="container">
					<div class="section-header">
						<h2>Latest from the Blog</h2>
						<p>Technical articles, tutorials, and WordPress insights.</p>
						<a href="/blog/" class="button">View All Posts</a>
					</div>
					<div class="blog-preview-grid">
						{% for post_item in latest_blog_posts %}
							<article class="blog-preview-card">
								{% if post_item.image_data %}
									<div class="blog-preview-image">
										<a href="{{ post_item.path }}">
											<img src="{{ post_item.image_data.src }}" alt="{{ post_item.image_data.alt }}" loading="lazy" />
										</a>
									</div>
								{% endif %}
								<div class="blog-preview-content">
									{% if post_item.tags %}
										<div class="blog-preview-tags">
											{% for tag in post_item.tags %}
												<a href="{{ tag.path }}" class="tag">{{ tag.title }}</a>
											{% endfor %}
										</div>
									{% endif %}
									<h3><a href="{{ post_item.path }}">{{ post_item.title }}</a></h3>
									<div class="blog-preview-meta">
										<time>{{ post_item.date }}</time>
										{% if post_item.reading_time %}
											<span class="reading-time">{{ post_item.reading_time }} min read</span>
										{% endif %}
									</div>
									{% if post_item.summary %}
										<p>{{ post_item.summary|striptags|slice(0, 150) ~ '...' }}</p>
									{% endif %}
								</div>
							</article>
						{% endfor %}
					</div>
				</div>
			</section>
		{% endif %}

		{# Contact CTA Section #}
		<section class="contact-cta-section section">
			<div class="container">
				<div class="contact-cta-inner">
					<h2>Let's Work Together</h2>
					<p>Interested in collaborating on a project or need WordPress expertise?</p>
					<a href="/contact/" class="button button--primary">Get in Touch</a>
				</div>
			</div>
		</section>
	{% endblock tabs %}

{% endembed %}
